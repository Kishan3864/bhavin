# Contact form delivery endpoint.
#
# Leave unset and the form hands the message to the visitor's mail client
# instead of reporting a success that did not happen.
#
# Set it to any URL that accepts POST { name, email, message } as JSON —
# a Formspree/Getform endpoint, a Resend-backed Route Handler, or your own API.
#
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
